# ==========================================
# KAYO MESTIZA - Backend Environment Variables
# ==========================================

# MongoDB Connection String (Get a free M0 cluster at https://www.mongodb.com/cloud/atlas)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=kayomestiza

# Security & Admin Authentication
JWT_SECRET=generate_a_random_32_character_string_here
ADMIN_EMAIL=eats@kayomestiza.com
ADMIN_PASSWORD=change_this_to_a_secure_password_for_admin_portal

# Allowed Frontend URLs for CORS (comma-separated, without trailing slashes)
CORS_ORIGINS=http://localhost:3000,https://kayomestiza.com,https://kayomestiza.vercel.app

# Google Gemini AI (Get a free API key at https://aistudio.google.com/)
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_TEXT_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_IMAGE_FALLBACK_MODEL=imagen-3.0-generate-002
